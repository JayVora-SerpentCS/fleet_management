<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Renew Tenancy Wizard Form View  -->
    <record id="view_writeoff_cancel_reason_wizard" model="ir.ui.view">
        <field name="name">writeoff.cancel.reason.form</field>
        <field name="model">writeoff.cancel.reason</field>
        <field name="arch" type="xml">
            <form>
                <separator string="Reason To Cancel" />
                <group>
                    <field name="reason" string="Reason" />
                </group>
                <footer>
                    <button
                        name="cancel_writoff"
                        type="object"
                        string="OK"
                        class="oe_highlight"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!--  Action for Renew Tenancy Wizard -->
    <record id="action_writeoff_cancel_reason_wizard" model="ir.actions.act_window">
        <field name="name">Write Off Cancel Reason Wizard</field>
        <field name="res_model">writeoff.cancel.reason</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
